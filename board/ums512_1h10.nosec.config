/* Board config fragment for ums512_1h10 (sharkl5pro), NON-SECURE build.
 *
 * These defines are normally generated at build time by the Android BSP
 * (chipram/AndroidChipram.mk) from BOARD_* variables set in the device tree
 * file device/sprd/sharkl5Pro/common/security_feature.mk.
 *
 * Resolved values for ums512_1h10 (BOARD_TEE_CONFIG=trusty, non feature phone,
 * not low mem, BOARD_SECBOOT_CONFIG=false):
 *   BOARD_SML_MEM_ADDR  = 0x94000000
 *   BOARD_TOS_MEM_ADDR  = 0x94020000
 *   BOARD_SEC_MEM_SIZE  = 0x2000000
 *   BOARD_ATF_CONFIG    = true
 *   BOARD_ATF_BOOT_TOS_CONFIG = true
 *   PRODUCT_SECURE_BOOT = NONE  (so no CONFIG_SECBOOT)
 *
 * This file is appended to out/include/config.h after "make ums512_1h10_config",
 * exactly the way AndroidChipram.mk appends its generated defines.
 */
#define CONFIG_LOAD_TOS_ALONE 1
#define CONFIG_LOAD_ATF 1
#define CONFIG_ATF_BOOT_TOS 1
/* Secure-world memory map, taken from the stock SPL binary (verified against
 * the device teecfg): SML=0x94000000, TRUSTOS=0x94060000, TEECFG=0x94040000. */
#define CONFIG_SML_LDADDR_START 0x94000000
#define CONFIG_TOS_LDADDR_START 0x94060000
#define CONFIG_TEECFG_LDADDR_START 0x94040000
#define CONFIG_SML_TOS_RUNNING_SIZE 0x2000000
#define CONFIG_SEC_MEM_SIZE 0x2000000
/* Stock is A/B (uboot_a/uboot_b, ...), it has no *_bak dual-backup partitions.
 * Disable the old dual-backup path so a patched u-boot is not hash-rejected. */
#undef CONFIG_DUAL_BACKUP
