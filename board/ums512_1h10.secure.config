/* Board config fragment for ums512_1h10 (sharkl5pro), SECURE build.
 *
 * Same memory map as the nosec fragment, plus the secure boot defines that
 * AndroidChipram.mk emits when PRODUCT_SECURE_BOOT=SPRD, which happens when
 * device/sprd/sharkl5Pro/common/security_feature.mk is included with
 * BOARD_SECBOOT_CONFIG=true (see the ums512_1h10_Natv.mk variant).
 *
 * With CONFIG_SECBOOT the SPL RSA verifies the images it loads (u-boot, sml,
 * trustos) against the keys fused in efuse. A device that is not fused, or an
 * image signed with a different key, will fail verification and the SPL will
 * stop. Only use this variant if your unit is fused and you sign the downstream
 * images with the matching key.
 */
#define CONFIG_LOAD_TOS_ALONE 1
#define CONFIG_LOAD_ATF 1
#define CONFIG_ATF_BOOT_TOS 1
#define CONFIG_SML_LDADDR_START 0x94000000
#define CONFIG_TOS_LDADDR_START 0x94020000
#define CONFIG_SML_TOS_RUNNING_SIZE 0x2000000
#define CONFIG_SEC_MEM_SIZE 0x2000000
#define CONFIG_SPRD_SECBOOT
#define CONFIG_SECBOOT
#define PKCS1_PSS_FLAG
