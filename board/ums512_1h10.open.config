/* Board config fragment for ums512_1h10 (sharkl5pro), OPEN secure build.
 *
 * This is the modding target. It builds with CONFIG_SECBOOT so the SPL does the
 * same secure-world bring-up the stock SPL does (the sprd_firewall_config_pre
 * secure-DDR firewall setup: dmc_sec/sml_teecfg_sec/... which the stock builds
 * under CONFIG_SECBOOT and which the secure world SML/trustos need), but it
 * defines CONFIG_SPL_SKIP_IMG_VERIFY so the four RSA image checks
 * (sml/trustos/teecfg/uboot) are stubbed out and always pass. That lets a
 * patched or self-built u-boot boot while everything else matches stock.
 *
 * Pair with the signing pipeline (rsa2048_0) so the BootROM accepts the SPL
 * itself; the DHTB/SIMGHDR framing is applied post-sign.
 */
#define CONFIG_LOAD_TOS_ALONE 1
#define CONFIG_LOAD_ATF 1
#define CONFIG_ATF_BOOT_TOS 1
/* Secure-world memory map, from the stock SPL binary / device teecfg. */
#define CONFIG_SML_LDADDR_START 0x94000000
#define CONFIG_TOS_LDADDR_START 0x94060000
#define CONFIG_TEECFG_LDADDR_START 0x94040000
#define CONFIG_SML_TOS_RUNNING_SIZE 0x2000000
#define CONFIG_SEC_MEM_SIZE 0x2000000
/* Enable the secure build (firewall + secure world), like stock. */
#define CONFIG_SPRD_SECBOOT
#define CONFIG_SECBOOT
#define PKCS1_PSS_FLAG
/* But stub the four RSA image checks so patched/self-built images boot. */
#define CONFIG_SPL_SKIP_IMG_VERIFY
/* Stock A/B layout has no *_bak partitions; disable dual-backup. */
#undef CONFIG_DUAL_BACKUP
/* Secure-handoff stock parity. Without FW_PARITY, the from-source SPL boots on a
 * fresh flash but hangs in SML/TOS on the first boot after Android has run and
 * shut down (Android provisions secure state that the non-parity handoff no
 * longer satisfies). FW_PARITY sizes PUB firewall seg0 to TEECFG..TOS like stock
 * (instead of a fixed 32MB that over-secures the region above TOS) and matches
 * the AON iram_sec PM/efuse ranges. Keep it on.
 *
 * FW_SEG7 (the PUB seg7 above-DRAM catch-all, reprogrammed every boot via
 * mem_top_catchall_sec) is OFF: it corrupts the efuse RAM shadow the kernel
 * reads for thermal sensor trim and CPU DVFS binning. Measured 2026-08-04 on
 * GammaOS, against a patched stock SPL as the reference, using board-thmzone as
 * the untrimmed ground truth:
 *
 *   PARITY  SEG7 | cpu0-5 policy | die vs board | result
 *   -------------+---------------+--------------+------------------------
 *   on      on   | absent        | 36-91C mess  | broken (as shipped)
 *   off     off  | present       | +45C uniform | broken
 *   on      off  | present       | +5..+7C      | matches stock  <== this
 *
 * With SEG7 on, dvfs_bin reads garbage so cpu0-5 never get a cpufreq policy at
 * all, and the per-sensor trim is scrambled. The false temperature then pins
 * every cluster to its frequency floor (degraded performance) and, under load,
 * pushes past the 110C critical trip (spurious reboots). Both user-visible
 * symptoms come from this one flag.
 *
 * Why seg7 damages the shadow is NOT understood - the evidence is behavioural,
 * not mechanistic. If seg7 was guarding something real, dropping it may bring
 * that back; re-test with the table above rather than assuming. Validated under
 * sustained 8-way load: throttling now regulates 94.6C -> 83.7C with no reboot. */
#undef CONFIG_SPL_FW_SEG7
#define CONFIG_SPL_FW_PARITY
