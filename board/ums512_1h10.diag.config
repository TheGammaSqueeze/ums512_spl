/* Board config fragment for ums512_1h10 (sharkl5pro), OPEN secure build.
 *
 * This is the modding target. It builds with CONFIG_SECBOOT so the SPL does the
 * same secure-world bring-up the stock SPL does (the sprd_firewall_config_pre
 * secure-DDR firewall setup: dmc_sec/sml_teecfg_sec/... which the stock builds
 * under CONFIG_SECBOOT and which the secure world SML/trustos need), but it
 * defines CONFIG_SPL_SKIP_IMG_VERIFY so the four RSA image checks
 * (sml/trustos/teecfg/uboot) are stubbed out and always pass. That lets a
 * patched or self-built u-boot boot while everything else matches stock.
 *
 * Pair with the signing pipeline (rsa2048_0) so the BootROM accepts the SPL
 * itself; the DHTB/SIMGHDR framing is applied post-sign.
 */
#define CONFIG_LOAD_TOS_ALONE 1
#define CONFIG_LOAD_ATF 1
#define CONFIG_ATF_BOOT_TOS 1
/* Secure-world memory map, from the stock SPL binary / device teecfg. */
#define CONFIG_SML_LDADDR_START 0x94000000
#define CONFIG_TOS_LDADDR_START 0x94060000
#define CONFIG_TEECFG_LDADDR_START 0x94040000
#define CONFIG_SML_TOS_RUNNING_SIZE 0x2000000
#define CONFIG_SEC_MEM_SIZE 0x2000000
/* Enable the secure build (firewall + secure world), like stock. */
#define CONFIG_SPRD_SECBOOT
#define CONFIG_SECBOOT
#define PKCS1_PSS_FLAG
/* But stub the four RSA image checks so patched/self-built images boot. */
#define CONFIG_SPL_SKIP_IMG_VERIFY
/* Stock A/B layout has no *_bak partitions; disable dual-backup. */
#undef CONFIG_DUAL_BACKUP
/* DIAGNOSTIC: haptic (vibrator) progress markers. The current markers live
 * inside the DDR PHY training loop (ddrc_train_seq): one buzz per trained
 * frequency, at the top of each iteration:
 *   1 buzz = 512M, 2 = 768M, 3 = 1024M, 4 = 1333M, 5 = 1536M, 6 = 1866M.
 * The highest count heard before silence names the frequency whose training
 * (vddcore voltage set / dmc_phy_train / bist) hangs. */
#define CONFIG_SPL_VIBRATE_MARKERS
/* DIAGNOSTIC: write a verbose snapshot of the SPL's pre-jump hardware state
 * (reset-control, DDR/PMU sleep+retention, DMC/PHY, firewall, clocks, image
 * checksums, EL3 CPU regs) to the uboot_log partition right before the SML jump.
 * Snapshots are ringed by reboot count into the always-zero mid-region of
 * uboot_log (1.5 MB in), past u-boot's own circular log, so successive boots do
 * not overwrite each other and a successful boot's u-boot log cannot clobber
 * them. The SPL runs to completion on the failing reboot, so its snapshot
 * persists even though SML/u-boot never come up. A single dump then holds the
 * cold boot and the failed warm reboot to diff. Adds an eMMC CMD25 write path
 * (diag-only). Decode with scripts/parse_spl_trace.py. */
#define CONFIG_SPL_EMMC_TRACE
/* PUB firewall seg7 above-DRAM catch-all (0x3280C380), reprogrammed every boot.
 * OFF, matching ums512_1h10.open.config: measured 2026-08-04 to corrupt the
 * efuse RAM shadow (thermal sensor trim + dvfs_bin), which costs cpu0-5 their
 * cpufreq policy entirely and drives false die temperatures. See the truth
 * table in open.config. Keep diag and open aligned here, or diag stops
 * reproducing what the shipped build actually does. */
#undef CONFIG_SPL_FW_SEG7
/* Full secure-handoff stock-parity bundle (still diagnosing the post-shutdown
 * hang): PUB firewall seg0 sized to TEECFG..TOS like stock instead of a fixed
 * 32MB, and the AON iram_sec PM/efuse ranges matched to stock. */
#define CONFIG_SPL_FW_PARITY
