/* Board config fragment for ums512_1h10 (sharkl5pro), OPEN secure build.
 *
 * This is the modding target. It builds with CONFIG_SECBOOT so the SPL does the
 * same secure-world bring-up the stock SPL does (the sprd_firewall_config_pre
 * secure-DDR firewall setup: dmc_sec/sml_teecfg_sec/... which the stock builds
 * under CONFIG_SECBOOT and which the secure world SML/trustos need), but it
 * defines CONFIG_SPL_SKIP_IMG_VERIFY so the four RSA image checks
 * (sml/trustos/teecfg/uboot) are stubbed out and always pass. That lets a
 * patched or self-built u-boot boot while everything else matches stock.
 *
 * Pair with the signing pipeline (rsa2048_0) so the BootROM accepts the SPL
 * itself; the DHTB/SIMGHDR framing is applied post-sign.
 */
#define CONFIG_LOAD_TOS_ALONE 1
#define CONFIG_LOAD_ATF 1
#define CONFIG_ATF_BOOT_TOS 1
/* Secure-world memory map, from the stock SPL binary / device teecfg. */
#define CONFIG_SML_LDADDR_START 0x94000000
#define CONFIG_TOS_LDADDR_START 0x94060000
#define CONFIG_TEECFG_LDADDR_START 0x94040000
#define CONFIG_SML_TOS_RUNNING_SIZE 0x2000000
#define CONFIG_SEC_MEM_SIZE 0x2000000
/* Enable the secure build (firewall + secure world), like stock. */
#define CONFIG_SPRD_SECBOOT
#define CONFIG_SECBOOT
#define PKCS1_PSS_FLAG
/* But stub the four RSA image checks so patched/self-built images boot. */
#define CONFIG_SPL_SKIP_IMG_VERIFY
/* Stock A/B layout has no *_bak partitions; disable dual-backup. */
#undef CONFIG_DUAL_BACKUP
/* DIAGNOSTIC: skip SML handoff, jump straight to u-boot (logo vs black test). */
#define CONFIG_SPL_JUMP_UBOOT_DIRECT
